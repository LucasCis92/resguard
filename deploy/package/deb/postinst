#!/bin/sh
# postinst del paquete .deb. Sigue el patrón que generan dh_installsysusers y
# dh_installsystemd de Debian: usa deb-systemd-helper y deb-systemd-invoke, que
# respetan un servicio enmascarado o desactivado por el administrador.
set -e

if [ "$1" = "configure" ]; then
	# Grupo cuyos miembros pueden usar resguardctl sin sudo.
	systemd-sysusers ${DPKG_ROOT:+--root="$DPKG_ROOT"} resguard.conf
fi

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
	deb-systemd-helper unmask 'resguard.service' >/dev/null || true
	# was-enabled es verdadero en una instalación nueva: se activa.
	if deb-systemd-helper --quiet was-enabled 'resguard.service'; then
		deb-systemd-helper enable 'resguard.service' >/dev/null || true
	else
		deb-systemd-helper update-state 'resguard.service' >/dev/null || true
	fi
fi

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
	if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			deb-systemd-invoke restart 'resguard.service' >/dev/null || true
		else
			deb-systemd-invoke start 'resguard.service' >/dev/null || true
		fi
	fi
fi

if [ "$1" = "configure" ] && [ -z "$2" ]; then
	cat <<'MSG'

resguard está instalado.
  Consultar:          resguardctl          (o: resguardctl status, resguardctl watch)
  Usarlo sin sudo:    sudo usermod -aG resguard $USER   y volver a iniciar sesión
  Configuración:      /etc/resguard/config.yaml   (aplicar: sudo systemctl reload resguard)
  Ayuda:              man resguardctl

MSG
fi
