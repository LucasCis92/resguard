#!/bin/sh
# prerm del paquete .deb (patrón de dh_installsystemd): detiene el servicio
# al desinstalar; en una actualización lo reinicia el postinst de la nueva versión.
set -e

if [ -z "${DPKG_ROOT:-}" ] && [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	deb-systemd-invoke stop 'resguard.service' >/dev/null || true
fi
