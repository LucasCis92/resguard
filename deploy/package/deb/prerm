#!/bin/sh
# prerm of the .deb package (dh_installsystemd pattern): stops the service on
# removal; on an upgrade the new version's postinst restarts it.
set -e

if [ -z "${DPKG_ROOT:-}" ] && [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	deb-systemd-invoke stop 'resguard.service' >/dev/null || true
fi
