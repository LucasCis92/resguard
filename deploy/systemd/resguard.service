[Unit]
Description=Resource monitor and incident recorder for services
Documentation=https://github.com/LucasCis92/resguard
After=dbus.service

[Service]
Type=simple
# Thresholds, intervals and monitored units: /etc/resguard/config.yaml.
ExecStart=/usr/bin/resguardd -group resguard -events-file /var/lib/resguard/events.jsonl
# "systemctl reload resguard" rereads the configuration without restarting.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# /run/resguard for the socket (reachable by the resguard group through the
# socket's own permissions) and /var/lib/resguard for the incident log.
RuntimeDirectory=resguard
RuntimeDirectoryMode=0755
StateDirectory=resguard
StateDirectoryMode=0750

# Hardening: the daemon only reads /proc and /sys and talks over Unix sockets.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
