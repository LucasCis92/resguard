[Unit]
Description=Monitor y gestor dinámico de recursos de servicios
Documentation=https://github.com/LucasCis92/resguard
After=dbus.service

[Service]
Type=simple
# Umbrales, intervalos y servicios vigilados: /etc/resguard/config.yaml.
ExecStart=/usr/local/bin/resguardd -group resguard -events-file /var/lib/resguard/events.jsonl
# "systemctl reload resguard" relee la configuración sin reiniciar.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# /run/resguard para el socket (accesible para el grupo resguard por los
# permisos del propio socket) y /var/lib/resguard para el registro de incidencias.
RuntimeDirectory=resguard
RuntimeDirectoryMode=0755
StateDirectory=resguard
StateDirectoryMode=0750

# Endurecimiento: el demonio solo lee /proc y /sys y habla por sockets Unix.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
